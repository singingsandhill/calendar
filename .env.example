# env 파일 양식
DB_URL=jdbc:h2:file:./data/dbname;DB_CLOSE_DELAY=-1;MODE=MySQL
DB_USERNAME=id
DB_PASSWORD=pw

# H2 웹 콘솔 (/h2-console) — 기본 비활성 (ADR common/security/0006). 로컬 개발에서만 true.
H2_CONSOLE_ENABLED=true

# 러너 관리자 계정
RUNNER_ADMIN_USERNAME=admin
RUNNER_ADMIN_PASSWORD=admin123

# 트레이딩 봇 설정 (Bithumb)
BITHUMB_ACCESS_KEY=your_access_key_here
BITHUMB_SECRET_KEY=your_secret_key_here
TRADING_BOT_ENABLED=false
# 운영 모드: LIVE / PAPER / BACKTEST. 기본 LIVE(실거래). 검증 시 PAPER 로 실주문 차단.
TRADING_BOT_MODE=LIVE
# (선택) 일봉 레짐 신호 매수 필터: OFF(기본) / BLOCK_BEAR / SCALE_BEAR — 리플레이(작업 6-B) 결과로만 켠다 (ADR trading/risk/0007)
# TRADING_REGIME_FILTER_MODE=OFF
# (선택) 재시작 후 자동 시작 — 기본 false. 오픈 포지션이 있으면 보호 전용 복구가 우선 (ADR stock/modes/0005)
# TRADING_BOT_AUTO_START=false

# 주식 트레이딩 봇 설정 (한국투자증권)
KIS_APP_KEY=your_kis_app_key_here
KIS_APP_SECRET=your_kis_app_secret_here
KIS_ACCOUNT_NUMBER=your_account_number_here
STOCK_BOT_ENABLED=false
# (선택) PAPER/BACKTEST 가상 예수금(원). 기본 10000000 — 거래일마다 이 금액에서 시작 (ADR stock/modes/0004)
# STOCK_BOT_PAPER_CASH=10000000
# (선택) 재시작 후 자동 시작 — 기본 false. 오픈 포지션이 있으면 보호 전용 복구가 우선 (ADR stock/modes/0005)
# STOCK_BOT_AUTO_START=false

# Stock 이메일 알림 설정 (Gmail SMTP)
# Gmail 앱 비밀번호 발급: Google 계정 > 보안 > 2단계 인증 > 앱 비밀번호
STOCK_MAIL_ENABLED=false
STOCK_MAIL_USERNAME=your_gmail@gmail.com
STOCK_MAIL_PASSWORD=your_16_digit_app_password
STOCK_MAIL_TO=recipient@example.com

# 네이버 서치어드바이저 사이트 인증 토큰
# https://searchadvisor.naver.com → 사이트 등록 → HTML 태그 방식 → content="..." 의 값만 추출하여 입력
NAVER_SITE_VERIFICATION=

# IndexNow (Bing/Yandex/Naver 등 호환) — true 시 매일 03:30 KST 사이트맵 URL 자동 제출. 운영에서만 true (개발 인스턴스가 켜면 실서비스 URL 을 중복 제출)
INDEXNOW_ENABLED=false

# Kakao OAuth2 Login (developers.kakao.com > 앱 > REST API 키 / 보안 > Client Secret)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
